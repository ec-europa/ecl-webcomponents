{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "./dist",
    "lib": ["dom", "es2020"],
    "module": "es2015",
    "rootDir": "./lib",
    "target": "es2015",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxFactory": "",
    "allowSyntheticDefaultImports": true,
    "declarationDir": "./dist/types",
    "types": ["node"]
  },
  "include": ["lib"],
  "exclude": ["node_modules"]
}
