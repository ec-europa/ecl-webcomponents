{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "./dist",
    "lib": ["dom", "es2020"],
    "module": "es2015",
    "rootDir": "./lib",
    "target": "es2017",
    "skipLibCheck": true,
    "moduleResolution": "bundler"
  },
  "include": ["lib"],
  "exclude": ["node_modules"]
}
