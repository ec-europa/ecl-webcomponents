{
  "name": "@ecl/ecl-webcomponents-vue-consumer",
  "version": "0.30.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run copy && vite",
    "build": "npm run copy && vite build",
    "copy": "ncp ../ecl-webcomponents/dist/ecl-webcomponents/build src/assets",
    "preview": "vite preview",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "pre-publish": "npm run build"
  },
  "dependencies": {
    "@ecl/ecl-webcomponents-vue": "0.30.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.4.11",
    "globals": "^17.9.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.78.0",
    "prettier": "3.9.6",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
