                              </span>
                            </a>
                          </li>
                        </ecl-language-item>
                        <ecl-language-item active="" lang-code="en" language="English" path="/example.html" slot="eu-category">
                          <li class="ecl-site-header__language-item sc-ecl-site-header-ec">
                            <a class="ecl-link ecl-link--standalone ecl-site-header__language-link ecl-site-header__language-link--active sc-ecl-site-header-ec" href="/example.html">
                              <span class="ecl-site-header__language-link-code sc-ecl-site-header-ec">
                                en
                              </span>
                              <span class="ecl-site-header__language-link-label sc-ecl-site-header-ec">
                                English
                              </span>
                            </a>
                          </li>
                        </ecl-language-item>
                        <ecl-language-item lang-code="fr" language="français" path="/example.html" slot="eu-category">
                          <li class="ecl-site-header__language-item sc-ecl-site-header-ec">
                            <a class="ecl-link ecl-link--standalone ecl-site-header__language-link sc-ecl-site-header-ec" href="/example.html">
                              <span class="ecl-site-header__language-link-code sc-ecl-site-header-ec">
                                fr
                              </span>
                              <span class="ecl-site-header__language-link-label sc-ecl-site-header-ec">
                                français
                              </span>
                            </a>
                          </li>
                        </ecl-language-item>
                        <ecl-language-item lang-code="ga" language="Gaeilge" path="/example.html" slot="eu-category">
                          <li class="ecl-site-header__language-item sc-ecl-site-header-ec">
                            <a class="ecl-link ecl-link--standalone ecl-site-header__language-link sc-ecl-site-header-ec" href="/example.html">
                              <span class="ecl-site-header__language-link-code sc-ecl-site-header-ec">
                                ga
