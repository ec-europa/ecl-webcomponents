// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`ecl-site-header renders 1`] = `
<ecl-site-header ecl-script="" eu-label="Official EU languages:" lang-code="en" language="english" language-aria-label="Choose language" language-block="" language-id="language-switcher" language-title="Choose your language" login-block="" login-link="/example.html" login-text="Log in" logo-alt="European Commission" logo-title="European commission" non-eu-label="Other languages:" search-block="" search-form-id="ecl-site-header-search-form" search-placeholder="Placeholder text" search-text="search" theme="ec">
  <!---->
  <header class="ecl-site-header ecl-site-header-with-logo-l">
    <div class="ecl-site-header__inner">
      <div class="ecl-site-header__header">
        <div class="ecl-container ecl-site-header__container">
          <div class="ecl-site-header__top" data-ecl-site-header-top>
            <ecl-link styleclass="ecl-site-header__logo-link sc-ecl-site-header-ec" variant="standalone">
              <ecl-picture image="/build/images/ec/logos/logo-ec--mute.svg" imagealt="European Commission" imgclass="ecl-site-header__logo-image ecl-site-header__logo-image--l sc-ecl-site-header-ec" styleclass="ecl-site-header__picture sc-ecl-picture-ec">
                <source media="(min-width: 415px)" srcset="/build/images/ec/logos/positive/logo-ec--en.svg">
              </ecl-picture>
            </ecl-link>
            <div class="ecl-site-header__action">
              <div class="ecl-site-header__login-container">
                <a aria-expanded="false" class="ecl-button ecl-button--tertiary ecl-site-header__login-toggle sc-ecl-site-header-ec" data-ecl-login-toggle href="/example.html">
                  <ecl-icon as-image="" icon="log-in" size="m" slot="icon-before" style-class="ecl-site-header__icon sc-ecl-site-header-ec"></ecl-icon>
                  Log in
                </a>
                <div class="ecl-site-header__login-box" data-ecl-login-box>
                  <p class="ecl-site-header__login-description"></p>
                  <hr class="ecl-site-header__login-separator">
                  <ecl-link variant="standalone"></ecl-link>
                </div>
              </div>
              <div class="ecl-site-header__language">
                <a aria-controls="language-switcher" aria-label="Choose language" class="ecl-button ecl-button--tertiary ecl-site-header__language-selector" data-ecl-language-selector role="button">
                  <span class="ecl-site-header__language-icon">
                    <ecl-icon icon="global" size="s" style-class="ecl-site-header__icon sc-ecl-site-header-ec"></ecl-icon>
                    english
                  </span>
                </a>
                <div aria-labelledby="ecl-site-header__language-title" aria-modal="true" class="ecl-site-header__language-container" data-ecl-language-list-overlay hidden="" id="language-switcher" role="dialog">
                  <div class="ecl-site-header__language-header">
                    <div class="ecl-site-header__language-title" id="ecl-site-header__language-title">
                      Choose your language
                    </div>
                    <ecl-button data-ecl-language-list-close hide-label="" style-class="ecl-site-header__language-close sc-ecl-site-header-ec" type="submit" variant="tertiary">
                      <ecl-icon data-ecl-icon icon="close" size="s" slot="icon-after" style-class="sc-ecl-site-header-ec"></ecl-icon>
                    </ecl-button>
                  </div>
                  <div class="ecl-site-header__language-content" data-ecl-language-list-content>
                    <div class="ecl-site-header__language-category" data-ecl-language-list-eu>
                      <div class="ecl-site-header__language-category-title">
                        Official EU languages:
                      </div>
                      <ul class="ecl-site-header__language-list">
                        <ecl-language-item lang-code="bg" language="български" path="/example.html" slot="eu-category">
                          <li class="ecl-site-header__language-item sc-ecl-site-header-ec">
                            <a class="ecl-link ecl-link--standalone ecl-site-header__language-link sc-ecl-site-header-ec" href="/example.html">
                              <span class="ecl-site-header__language-link-code sc-ecl-site-header-ec">
                                bg
                              </span>
                              <span class="ecl-site-header__language-link-label sc-ecl-site-header-ec">
                                български
                              </span>
                            </a>
                          </li>
                        </ecl-language-item>
                        <ecl-language-item lang-code="es" language="español" path="/example.html" slot="eu-category">
