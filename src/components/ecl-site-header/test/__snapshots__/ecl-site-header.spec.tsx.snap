                      <ecl-icon icon="corner-arrow" rotate="90" size="2xs" slot="icon-after" style-class="sc-ecl-mega-menu-ec is-first"></ecl-icon>
                      <ecl-icon flip="horizontal" icon="arrow-left" size="s" slot="icon-after" style-class="sc-ecl-mega-menu-ec"></ecl-icon>
                    </span>
