                                eesti
                              </span>
                            </a>
                          </li>
                        </ecl-language-item>
                        <ecl-language-item lang-code="el" language="ελληνικά" path="/example.html" slot="eu-category">
                          <li class="ecl-site-header__language-item sc-ecl-site-header-ec">
                            <a class="ecl-link ecl-link--standalone ecl-site-header__language-link sc-ecl-site-header-ec" href="/example.html">
                              <span class="ecl-site-header__language-link-code sc-ecl-site-header-ec">
