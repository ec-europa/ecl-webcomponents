</ecl-button>
`;

exports[`ecl-button renders correctly with an icon before 1`] = `
<ecl-button variant="tertiary">
  <!---->
  <button class="ecl-button ecl-button--tertiary" type="submit">
    <span class="ecl-button__container">
      <ecl-icon icon="check" slot="icon-before">
