exports[`ecl-button renders correctly with an icon after 1`] = `
<ecl-button variant="primary">
  <!---->
  <button class="ecl-button ecl-button--primary" type="submit">
    <span class="ecl-button__container">
      <span class="ecl-button__label" data-ecl-label>
        Button label
