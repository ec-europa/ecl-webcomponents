// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`ecl-tag renders correctly as a tag set 1`] = `
<ecl-tag-set>
  <ul class="ecl-tag-set sc-ecl-tag-ec">
    <li class="ecl-tag-set__item sc-ecl-tag-ec">
      <ecl-tag url="/example.html" variant="link">
        <!---->
        <a class="ecl-tag ecl-tag--link" href="/example.html">
          A link ECL tag
        </a>
      </ecl-tag>
    </li>
    <li class="ecl-tag-set__item sc-ecl-tag-ec">
      <ecl-tag variant="removable">
        <!---->
        <button class="ecl-tag ecl-tag--removable" type="button">
          A removable ECL tag
          <span class="ecl-tag__icon">
            <ecl-icon style-class="ecl-tag__icon-close sc-ecl-tag-ec">
              <svg class="ecl-icon ecl-icon--xs ecl-tag__icon-close sc-ecl-tag-ec">
                <use xlink:href="/build/images/ec/icons.svg#close-outline"></use>
              </svg>
            </ecl-icon>
          </span>
        </button>
      </ecl-tag>
    </li>
  </ul>
</ecl-tag-set>
`;

exports[`ecl-tag renders correctly in the link variant 1`] = `
<ecl-tag url="/example.html" variant="link">
  <!---->
  <a class="ecl-tag ecl-tag--link" href="/example.html">
    A link ECL tag
  </a>
</ecl-tag>
`;

exports[`ecl-tag renders correctly in the removable variant 1`] = `
<ecl-tag variant="removable">
  <!---->
  <button class="ecl-tag ecl-tag--removable" type="button">
