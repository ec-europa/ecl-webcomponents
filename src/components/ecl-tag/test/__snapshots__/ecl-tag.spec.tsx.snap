exports[`ecl-tag renders correctly with a custom color mode 1`] = `
<ecl-tag color-mode="blue-navy" variant="removable">
  <!---->
  <button class="ecl-color-mode--blue-navy ecl-tag ecl-tag--removable" type="button">
    A removable ECL tag
    <span class="ecl-tag__icon">
      <ecl-icon style-class="ecl-tag__icon-close sc-ecl-tag-ec">
        <svg class="ecl-icon ecl-icon--xs ecl-tag__icon-close sc-ecl-tag-ec">
          <use xlink:href="/build/images/ec/icons.svg#close-outline"></use>
        </svg>
      </ecl-icon>
    </span>
  </button>
</ecl-tag>
`;

exports[`ecl-tag renders correctly with external 1`] = `
<ecl-tag external="" url="/example.html" variant="link">
  <!---->
  <a class="ecl-tag ecl-tag--link" href="/example.html">
    An external link ECL tag
    <ecl-icon style-class="ecl-tag__icon ecl-tag__icon--external sc-ecl-tag-ec">
      <svg class="ecl-icon ecl-icon--2xs ecl-tag__icon ecl-tag__icon--external sc-ecl-tag-ec">
        <use xlink:href="/build/images/ec/icons.svg#external"></use>
      </svg>
    </ecl-icon>
  </a>
</ecl-tag>
`;

exports[`ecl-tag renders correctly with no-wrap 1`] = `
