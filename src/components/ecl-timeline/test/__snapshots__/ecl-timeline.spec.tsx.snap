exports[`ecl-timeline renders 1`] = `
<ecl-timeline color-mode="green">
  <!---->
  <div class="ecl-color-mode--green ecl-timeline ecl-timeline--has-headline" data-ecl-auto-initialized="true" data-ecl-timeline role="list">
    <ecl-timeline-item el-id="el-headline" item-title="Headline title" label="2025" type="headline">
      <!---->
      <div class="ecl-timeline__item ecl-timeline__item--headline sc-ecl-timeline-ec" id="el-headline" role="listitem">
        <div class="ecl-timeline__tooltip sc-ecl-timeline-ec">
          <div class="ecl-timeline__tooltip-arrow sc-ecl-timeline-ec"></div>
          <div class="ecl-timeline__label sc-ecl-timeline-ec">
            2025
          </div>
          <div class="ecl-timeline__title sc-ecl-timeline-ec">
            Headline title
          </div>
          <div class="ecl-timeline__content sc-ecl-timeline-ec">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus eu metus risus.
          </div>
        </div>
      </div>
    </ecl-timeline-item>
    <ecl-timeline-item el-id="0" item-title="Item title" label="13 September 2017">
      <!---->
      <div class="ecl-timeline__item sc-ecl-timeline-ec" id="0" role="listitem">
        <div class="ecl-timeline__tooltip sc-ecl-timeline-ec">
