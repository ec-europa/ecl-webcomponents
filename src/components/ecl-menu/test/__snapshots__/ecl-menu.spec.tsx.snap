exports[`ecl-menu renders 1`] = `
<ecl-menu back-label="Back" close-label="Close" group="group1" max-lines="2" menu-link="/example.html" menu-title="Menu" next-label="next" previous-label="previous" theme="ec">
  <!---->
  <nav class="ecl-menu sc-ecl-menu-ec" data-ecl-auto-initialized="true" data-ecl-menu data-ecl-menu-max-lines="2" data-expanded="false" role="navigation">
    <div class="ecl-menu__overlay" data-ecl-menu-overlay></div>
