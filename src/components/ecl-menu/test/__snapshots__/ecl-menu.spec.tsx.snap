          <span class="ecl-button__container">
            <ecl-icon slot="icon-before">
              <span class="ecl-button__icon ecl-icon ecl-icon--m sc-ecl-button-ec sc-ecl-menu-ec wt-icon--hamburger wt-icon--placeholder"></span>
            </ecl-icon>
            <span class="ecl-button__label" data-ecl-label>
              Menu
            </span>
            <ecl-icon slot="icon-after">
              <span class="ecl-icon ecl-icon--m ecl-menu__close-switch sc-ecl-menu-ec wt-icon--close wt-icon--placeholder"></span>
            </ecl-icon>
          </span>
        </button>
      </ecl-button>
      <section aria-label="Menu" class="ecl-menu__inner" data-ecl-menu-inner>
