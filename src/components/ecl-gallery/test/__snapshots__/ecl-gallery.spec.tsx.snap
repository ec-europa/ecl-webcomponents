// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`ecl-gallery renders 1`] = `
<ecl-gallery close-label="Close" counter-label="Media files in this gallery" counter-separator="of" download-label="Download" ecl-script="" el-id="ecl-gallery-demo-test" grid="" grid-template="2" next-label="Next" prev-label="Previous" share-label="Share" view-all-label="View all" visible-items="9">
  <!---->
  <section class="ecl-gallery ecl-gallery--grid ecl-gallery--ratio-3-2 ecl-gallery--template-2" data-ecl-auto-initialized="true" data-ecl-gallery data-ecl-gallery-visible-items="9" id="ecl-gallery-demo-test">
    <ul class="ecl-gallery__list">
      <li class="ecl-gallery__item sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-1">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-id="0" data-ecl-gallery-item-share="/example.html" href="https://inno-ecl.s3.amazonaws.com/media/examples/example-image.jpg">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image8.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image.jpg" image-alt="Image 1" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-1-title">
                The EU in brief, institutions and bodies, countries, symbols, history, facts and figures
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for image 1
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-2">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-embed-src="https://www.youtube.com/embed/fgi-GSCB6ho" data-ecl-gallery-item-id="1" href="https://www.youtube.com/embed/fgi-GSCB6ho">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image10.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example.html-external-video.jpg" image-alt="New digital strategy" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <div class="ecl-gallery__item-icon-wrapper sc-ecl-gallery-ec">
              <ecl-icon style-class="ecl-gallery__item-icon sc-ecl-gallery-ec">
                <span class="ecl-gallery__item-icon ecl-icon ecl-icon--l sc-ecl-gallery-ec wt-icon--inverted wt-icon--placeholder wt-icon--play-filled"></span>
              </ecl-icon>
            </div>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-2-title">
                New digital strategy
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for embedded media
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-3">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-id="2" data-ecl-gallery-item-share="/example.html" href="https://inno-ecl.s3.amazonaws.com/media/examples/example-image2.jpg">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image11.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image2.jpg" image-alt="Image 2" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-3-title">
                Information on agriculture, business, culture, health, etc.
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for image 2
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-4">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-id="3" data-ecl-gallery-item-share="/example.html" href="https://inno-ecl.s3.amazonaws.com/media/examples/example-image3.jpg">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image5.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image3.jpg" image-alt="Image 3" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-4-title">
                Living, working, travelling in the EU
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for image 3
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-5">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-id="4" data-ecl-gallery-item-share="/example.html" href="https://inno-ecl.s3.amazonaws.com/media/examples/example-image4.jpg">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image7.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image4.jpg" image-alt="Image 3" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-5-title">
                Information on taxes, customs, importing and exporting goods, financial support for businesses
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for image 4
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-6">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-id="5" data-ecl-gallery-item-share="/example.html">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <video class="ecl-gallery__image sc-ecl-gallery-ec" poster="https://inno-ecl.s3.amazonaws.com/media/examples/example-image6.jpg" slot="video">
              <source src="https://inno-ecl.s3.amazonaws.com/media/videos/big_buck_bunny.mp4" type="video/mp4">
              <source src="https://inno-ecl.s3.amazonaws.com/media/videos/big_buck_bunny.webm" type="video/webm">
              <track kind="captions" label="English" src="/captions/bunny-en.vtt" srclang="en">
              <track kind="captions" label="français" src="/captions/bunny-fr.vtt" srclang="fr">
            </video>
            <div class="ecl-gallery__item-icon-wrapper sc-ecl-gallery-ec">
              <ecl-icon style-class="ecl-gallery__item-icon sc-ecl-gallery-ec">
                <span class="ecl-gallery__item-icon ecl-icon ecl-icon--l sc-ecl-gallery-ec wt-icon--inverted wt-icon--placeholder wt-icon--play-filled"></span>
              </ecl-icon>
            </div>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-6-title">
                EU law
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for video
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-7">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-id="6" data-ecl-gallery-item-share="/example.html" href="https://inno-ecl.s3.amazonaws.com/media/examples/example-image7.jpg">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image9.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image7.jpg" image-alt="Image 6" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-7-title">
                Find official documents, publications, statistics, open data and more resources
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for image 6
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-8">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-id="7" data-ecl-gallery-item-share="/example.html" href="https://inno-ecl.s3.amazonaws.com/media/examples/example-image8.jpg">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image3.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image8.jpg" image-alt="Image 7" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-8-title">
                Teaching material about the EU, including books and maps
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for image 7
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-9">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-embed-src="https://audiovisual.ec.europa.eu/embed/index.html?ref=I-223223&amp;lg=EN" data-ecl-gallery-item-id="8" data-ecl-gallery-item-share="/example.html" href="https://audiovisual.ec.europa.eu/embed/index.html?ref=I-223223&amp;lg=EN">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image5.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image9.jpg" image-alt="Image 8" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-9-title">
                Teaching material about the EU, including books and maps
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for image 8
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item ecl-gallery__item--hidden sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-10">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-id="9" data-ecl-gallery-item-share="/example.html" href="https://inno-ecl.s3.amazonaws.com/media/examples/example-image.jpg">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image1.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image.jpg" image-alt="Image 9" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-10-title">
                About the EU
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for image 9
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
      <li class="ecl-gallery__item ecl-gallery__item--hidden sc-ecl-gallery-ec" id="ecl-gallery-demo-test-item-10">
        <a class="ecl-gallery__item-link sc-ecl-gallery-ec" data-ecl-gallery-item data-ecl-gallery-item-id="10" data-ecl-gallery-item-share="/example.html" href="https://inno-ecl.s3.amazonaws.com/media/examples/example-image10.jpg">
          <figure class="ecl-gallery__image-container sc-ecl-gallery-ec">
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image3.jpg" img-class="ecl-gallery__image sc-ecl-gallery-ec" style-class="ecl-gallery__thumbnail sc-ecl-gallery-ec"></ecl-picture>
            <ecl-picture image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image10.jpg" image-alt="Image 10" img-class="ecl-gallery__image sc-ecl-gallery-ec" lazy="" styleclass="ecl-gallery__picture sc-ecl-gallery-ec"></ecl-picture>
            <figcaption class="ecl-gallery__description sc-ecl-gallery-ec" data-ecl-gallery-description>
              <div class="ecl-gallery__title" data-ecl-gallery-title id="ecl-gallery-demo-test-item-10-title">
                EU by topic
              </div>
              <span class="ecl-gallery__meta sc-ecl-gallery-ec" data-ecl-gallery-meta>
                Copyright, Author, Licence for image 10
              </span>
            </figcaption>
          </figure>
        </a>
      </li>
    </ul>
    <div class="ecl-gallery__footer">
      <div class="ecl-gallery__info">
        <div class="ecl-gallery__info-total">
          <strong data-ecl-gallery-count></strong>
          Media files in this gallery
        </div>
        <ecl-button data-ecl-gallery-all data-ecl-gallery-collapsed-label="View all">
          <!---->
          <button class="ecl-button ecl-button--tertiary ecl-gallery__view-all sc-ecl-gallery-ec" data-ecl-gallery-all="eclGalleryAll" data-ecl-gallery-collapsed-label="View all" type="submit">
            <span class="ecl-button__container">
              <span class="ecl-button__label" data-ecl-label>
                View all
              </span>
            </span>
          </button>
        </ecl-button>
      </div>
      <hr class="ecl-gallery__footer-divider">
    </div>
    <dialog class="ecl-gallery__overlay" data-ecl-gallery-overlay>
      <header class="ecl-gallery__close" data-ecl-gallery-overlay-header>
        <ecl-button data-ecl-gallery-close hide-label="" style-class="ecl-gallery__close-button sc-ecl-gallery-ec">
          <!---->
          <button class="ecl-button ecl-button--icon-only ecl-button--inverted ecl-button--tertiary ecl-gallery__close-button sc-ecl-gallery-ec" data-ecl-gallery-close="eclGalleryClose" type="submit">
            <span class="ecl-button__container">
              <span class="ecl-button__label" data-ecl-label>
                Close
              </span>
              <ecl-icon slot="icon-after" style-class="sc-ecl-gallery-ec">
                <span class="ecl-button__icon ecl-icon ecl-icon--m sc-ecl-button-ec sc-ecl-gallery-ec wt-icon--close wt-icon--placeholder"></span>
              </ecl-icon>
            </span>
          </button>
        </ecl-button>
      </header>
      <section class="ecl-gallery__slider">
        <div class="ecl-gallery__slider-media-container" data-ecl-gallery-overlay-media></div>
      </section>
      <footer class="ecl-gallery__detail" data-ecl-gallery-overlay-footer>
        <div class="ecl-container">
          <div class="ecl-gallery__detail-container">
            <div class="ecl-gallery__pager">
              <div class="ecl-gallery__detail-counter">
                <span data-ecl-gallery-overlay-counter-current>
                  0
                </span>
                of
                <span data-ecl-gallery-overlay-counter-max>
                  0
                </span>
              </div>
              <div class="ecl-gallery__controls">
                <ecl-button data-ecl-gallery-overlay-previous hide-label="" style-class="ecl-gallery__slider-previous sc-ecl-gallery-ec">
                  <!---->
                  <button class="ecl-button ecl-button--icon-only ecl-button--tertiary ecl-gallery__slider-previous sc-ecl-gallery-ec" data-ecl-gallery-overlay-previous="eclGalleryOverlayPrevious" type="button">
                    <span class="ecl-button__container">
                      <ecl-icon slot="icon-before" style-class="sc-ecl-gallery-ec">
                        <span class="ecl-button__icon ecl-icon ecl-icon--s sc-ecl-button-ec sc-ecl-gallery-ec wt-icon--corner-arrow wt-icon--placeholder wt-icon--rotate-270"></span>
                      </ecl-icon>
                      <span class="ecl-button__label" data-ecl-label>
                        Previous
                      </span>
                    </span>
                  </button>
                </ecl-button>
              </div>
              <ecl-button data-ecl-gallery-overlay-next hide-label="" style-class="ecl-gallery__slider-next sc-ecl-gallery-ec">
                <!---->
                <button class="ecl-button ecl-button--icon-only ecl-button--tertiary ecl-gallery__slider-next sc-ecl-gallery-ec" data-ecl-gallery-overlay-next="eclGalleryOverlayNext" type="button">
                  <span class="ecl-button__container">
                    <span class="ecl-button__label" data-ecl-label>
                      Next
                    </span>
                    <ecl-icon slot="icon-after" style-class="sc-ecl-gallery-ec">
                      <span class="ecl-button__icon ecl-icon ecl-icon--s sc-ecl-button-ec sc-ecl-gallery-ec wt-icon--corner-arrow wt-icon--placeholder wt-icon--rotate-90"></span>
                    </ecl-icon>
                  </span>
                </button>
              </ecl-button>
            </div>
            <div class="ecl-gallery__detail-actions">
              <ecl-link data-ecl-gallery-overlay-download path="" style-class="ecl-gallery__download sc-ecl-link-ec sc-ecl-gallery-ec" target="blank" theme="ec" variant="standalone">
                <ecl-icon slot="icon-after">
                  <span class="ecl-icon ecl-icon--fluid wt-icon--fullscreen wt-icon--placeholder"></span>
                </ecl-icon>
              </ecl-link>
              <ecl-link data-ecl-gallery-overlay-share path="" style-class="ecl-gallery__share sc-ecl-gallery-ec" theme="ec" variant="standalone">
                Share
                <ecl-icon slot="icon-after">
                  <span class="ecl-icon ecl-icon--fluid wt-icon--placeholder wt-icon--share"></span>
                </ecl-icon>
              </ecl-link>
            </div>
          </div>
          <div class="ecl-gallery__detail-description" data-ecl-gallery-overlay-description></div>
          <div class="ecl-gallery__detail-meta" data-ecl-gallery-overlay-meta></div>
        </div>
      </footer>
    </dialog>
  </section>
</ecl-gallery>
`;
