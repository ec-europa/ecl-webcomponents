// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`ecl-message renders 1`] = `
<ecl-message close-label="Close" ecl-script="" message-title="Title for a message" theme="ec" variant="information">
  <!---->
  <div class="ecl-message ecl-message--info" data-ecl-message role="alert">
    <ecl-icon style-class="ecl-message__icon sc-ecl-message-ec">
      <span class="ecl-icon ecl-message__icon sc-ecl-message-ec wt-icon--information wt-icon--l wt-icon--placeholder"></span>
    </ecl-icon>
    <div class="ecl-message__content">
      <ecl-button data-ecl-message-close style-class="ecl-message__close sc-ecl-message-ec">
        <!---->
        <button class="ecl-button ecl-button--ghost ecl-message__close sc-ecl-message-ec" data-ecl-message-close="eclMessageClose" type="button">
          <span class="ecl-button__container">
            <span class="ecl-button__label">
              Close
            </span>
            <ecl-icon slot="icon-after" style-class="ecl-button__icon ecl-button__icon--after">
              <span class="ecl-button__icon ecl-button__icon--after ecl-icon sc-ecl-button-ec wt-icon--close-filled wt-icon--placeholder wt-icon--xs"></span>
            </ecl-icon>
          </span>
        </button>
      </ecl-button>
      <div class="ecl-message__title">
        Title for a message
      </div>
      <div class="ecl-message__description">
        Lorem ipsum dolor sit amet
      </div>
    </div>
  </div>
</ecl-message>
`;
