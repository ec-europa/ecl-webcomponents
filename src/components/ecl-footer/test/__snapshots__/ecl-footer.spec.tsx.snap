exports[`ecl-footer EU renders 1`] = `
<ecl-footer-eu description="This site is managed by" description-name="the Directorate-General for Communication" logo-alt="European Union" logo-lang-code="en" logo-link="/example.html" logo-title="European union" variant="core">
  <!---->
  <footer class="ecl-site-footer ecl-site-footer--core">
    <div class="ecl-site-footer__main">
      <div class="ecl-container ecl-site-footer__container">
        <div class="ecl-site-footer__row">
          <div class="ecl-site-footer__column">
            <div class="ecl-site-footer__section">
              <ecl-link>
                <!---->
                <a class="ecl-link ecl-link--standalone ecl-site-footer__logo-link sc-ecl-footer-eu-eu" href="/example.html">
                  <ecl-picture image="/build/images/eu/logos/condensed-version/positive/logo-eu--en.svg" imagealt="European Union" imgclass="sc-ecl-footer-eu-eu ecl-site-footer__logo-image" styleclass="ecl-site-footer__picture sc-ecl-site-footer-eu-eu" theme="eu">
                    <source media="(min-width: 996px)" srcset="/build/images/eu/logos/standard-version/positive/logo-eu--en.svg">
                  </ecl-picture>
                </a>
              </ecl-link>
              <div class="ecl-site-footer__description">
                This site is managed by
              </div>
            </div>
          </div>
          <div class="ecl-site-footer__column">
            <div class="ecl-site-footer__section">
              <div class="ecl-site-footer__list" role="list">
                <ecl-text size="m" slot="ecl-footer-list-main" style-class="ecl-site-footer__title ecl-site-footer__title--separator" tag="div">
                  <!---->
                  <div class="ecl-site-footer__title ecl-site-footer__title--separator ecl-u-type-m sc-ecl-footer-eu-eu">
                    Contact the EU
                  </div>
                </ecl-text>
                <ecl-footer-item class="ecl-site-footer__list-item sc-ecl-footer-ec-ec" link="tel:0080067891011" slot="ecl-footer-list-main">
                  <!---->
