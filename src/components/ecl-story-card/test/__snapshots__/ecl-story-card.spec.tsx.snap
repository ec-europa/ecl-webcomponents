        <ecl-button button-style="neutral" data-ecl-story-card-grid-play hide-label="" style-class="ecl-story-card__grid-play sc-ecl-story-card-ec">
          <!---->
          <button class="ecl-button ecl-button--icon-only ecl-button--neutral ecl-button--secondary ecl-story-card__grid-play sc-ecl-story-card-ec" data-ecl-story-card-grid-play="eclStoryCardGridPlay" type="button">
            <span class="ecl-button__container">
              <span class="ecl-button__label" data-ecl-label>
                Play
              </span>
              <ecl-icon slot="icon-after">
                <span class="ecl-button__icon ecl-icon ecl-icon--l sc-ecl-button-ec wt-icon--placeholder wt-icon-phosphor--play-filled"></span>
              </ecl-icon>
            </span>
          </button>
        </ecl-button>
        <ecl-button button-style="neutral" data-ecl-story-card-grid-next hide-label="" style-class="ecl-story-card__grid-next sc-ecl-story-card-ec">
          <!---->
          <button class="ecl-button ecl-button--icon-only ecl-button--neutral ecl-button--tertiary ecl-story-card__grid-next sc-ecl-story-card-ec" data-ecl-story-card-grid-next="eclStoryCardGridNext" type="button">
            <span class="ecl-button__container">
              <span class="ecl-button__label" data-ecl-label>
                Next
              </span>
              <ecl-icon slot="icon-after">
                <span class="ecl-button__icon ecl-icon ecl-icon--l sc-ecl-button-ec wt-icon--placeholder wt-icon-phosphor--caret-right"></span>
              </ecl-icon>
            </span>
          </button>
        </ecl-button>
      </div>
    </div>
  </section>
</ecl-story-card>
`;
