              <span class="ecl-icon--xs ecl-table__icon ecl-table__icon-down sc-ecl-table-ec wt-icon--solid-arrow"></span>
            </button>
          </th>
        </tr>
      </thead>
      <tbody class="ecl-table__body">
        <tr class="ecl-table__row" data-ecl-table-order="0">
          <td class="ecl-table__cell" data-ecl-table-header="country">
