                <use xlink:href="/build/images/ec/icons.svg#information"></use>
              </svg>
            </ecl-icon>
            <ecl-link>
              <!---->
              <a class="ecl-link ecl-link--default ecl-news-ticker__slide-text sc-ecl-news-ticker-ec" href="/example.html">
                Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat
              </a>
            </ecl-link>
          </li>
          <li class="ecl-news-ticker__slide sc-ecl-news-ticker-ec">
            <ecl-link>
              <!---->
              <a class="ecl-link ecl-link--default ecl-news-ticker__slide-text sc-ecl-news-ticker-ec" href="/example.html">
                Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur
              </a>
            </ecl-link>
          </li>
          <li class="ecl-news-ticker__slide sc-ecl-news-ticker-ec">
            <ecl-icon>
              <svg class="ecl-icon ecl-icon--l ecl-news-ticker__icon sc-ecl-news-ticker-ec">
                <use xlink:href="/build/images/ec/icons.svg#livestreaming"></use>
              </svg>
            </ecl-icon>
            <ecl-link>
              <!---->
              <a class="ecl-link ecl-link--default ecl-news-ticker__slide-text sc-ecl-news-ticker-ec" href="/example.html">
                Excepteur sint occaecat cupidatat officia deserunt mollit anim id est laborum
              </a>
            </ecl-link>
          </li>
          <li class="ecl-news-ticker__slide sc-ecl-news-ticker-ec">
            <ecl-icon>
              <svg class="ecl-icon ecl-icon--l ecl-news-ticker__icon sc-ecl-news-ticker-ec">
                <use xlink:href="/build/images/ec/icons.svg#global"></use>
              </svg>
            </ecl-icon>
            <ecl-link>
              <!---->
              <a class="ecl-link ecl-link--default ecl-news-ticker__slide-text sc-ecl-news-ticker-ec" href="/example.html">
                Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium
              </a>
            </ecl-link>
          </li>
          <li class="ecl-news-ticker__slide sc-ecl-news-ticker-ec">
            <ecl-link>
              <!---->
              <a class="ecl-link ecl-link--default ecl-news-ticker__slide-text sc-ecl-news-ticker-ec" href="/example.html">
