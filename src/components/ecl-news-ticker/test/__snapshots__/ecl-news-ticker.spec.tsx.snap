exports[`ecl-news-ticker renders 1`] = `
<ecl-news-ticker counter-label="of" ecl-script="" items-length="6" sr-next="Next item" sr-pause="Pause news ticker" sr-prev="Prev item">
  <!---->
  <div class="ecl-news-ticker">
    <div class="ecl-news-ticker__container">
      <div class="ecl-news-ticker__content">
        <ul class="ecl-news-ticker__slides">
          <li class="ecl-news-ticker__slide sc-ecl-news-ticker-ec">
            <ecl-icon>
              <svg class="ecl-icon ecl-icon--l ecl-news-ticker__icon sc-ecl-news-ticker-ec">
                <use xlink:href="/build/images/ec/icons.svg#global"></use>
              </svg>
            </ecl-icon>
            <ecl-link>
              <!---->
              <a class="ecl-link ecl-link--default ecl-news-ticker__slide-text sc-ecl-news-ticker-ec" href="/example.html">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit'
