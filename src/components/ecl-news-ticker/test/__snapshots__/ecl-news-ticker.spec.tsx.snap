          </li>
        </ul>
      </div>
    </div>
    <div class="ecl-news-ticker__controls">
      <div class="ecl-news-ticker__actions">
        <button class="ecl-button ecl-button--icon-only ecl-button--tertiary ecl-news-ticker__prev sc-ecl-news-ticker-ec" data-ecl-news-ticker-prev="eclNewsTickerPrev" type="button">
          <span class="ecl-button__container">
            <span class="ecl-button__label" data-ecl-label>
              Prev item
            </span>
            <ecl-icon slot="icon-after">
              <svg class="ecl-button__icon ecl-icon ecl-icon--l ecl-icon--rotate-270 sc-ecl-button-ec sc-ecl-news-ticker-ec">
                <use xlink:href="/build/images/ec/icons.svg#corner-arrow"></use>
              </svg>
            </ecl-icon>
          </span>
