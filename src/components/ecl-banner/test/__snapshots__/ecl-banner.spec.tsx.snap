exports[`ecl-banner renders correctly in full width, with large size, text on the right and at the bottom, with small font size 1`] = `
<ecl-banner banner-title="EU Budget for the future" credit="© Copyright or credit" font-size="s" full-width="true" horizontal="right" size="l" vertical="botttom">
  <!---->
  <section class="ecl-banner ecl-banner--box-bg-light ecl-banner--font-s ecl-banner--full-width ecl-banner--h-right ecl-banner--l ecl-banner--no-media ecl-banner--v-botttom">
    <div class="ecl-banner__info ecl-container">
      <div class="ecl-banner__container" data-ecl-banner-container>
        <div class="ecl-banner__content">
          <div class="ecl-banner__title">
            <span class="ecl-banner__title-text">
              EU Budget for the future
            </span>
          </div>
          <p class="ecl-banner__description">
            <span class="ecl-banner__description-text">
              Innovation, economy, environment and geopolitics
            </span>
          </p>
        </div>
      </div>
    </div>
  </section>
</ecl-banner>
`;

