          <span class="ecl-button__container sc-ecl-banner-ec">
            <span class="ecl-button__label" data-ecl-label></span>
            <ecl-icon slot="icon-after">
              <span class="ecl-button__icon ecl-icon ecl-icon--m sc-ecl-banner-ec sc-ecl-button-ec wt-icon--pause-outline wt-icon--placeholder"></span>
            </ecl-icon>
