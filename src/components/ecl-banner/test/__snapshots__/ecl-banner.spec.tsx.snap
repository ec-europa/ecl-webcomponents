exports[`ecl-banner renders correctly with an image 1`] = `
<ecl-banner banner-title="EU Budget for the future" credit="© Copyright or credit" cta-label="Subscribe" cta-link="/example.html" image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image.jpg">
  <!---->
  <section class="ecl-banner ecl-banner--box-bg-light ecl-banner--color-dark ecl-banner--font-m ecl-banner--h-left ecl-banner--m ecl-banner--v-center">
    <figure class="ecl-banner__picture-container">
      <ecl-picture data-ecl-banner-image image="https://inno-ecl.s3.amazonaws.com/media/examples/example-image.jpg" imgclass="ecl-banner__image sc-ecl-banner-ec" styleclass="ecl-banner__picture sc-ecl-banner-ec"></ecl-picture>
      <footer class="ecl-banner__credit" data-ecl-banner-footer>
        <div class="ecl-container">
          © Copyright or credit
        </div>
      </footer>
    </figure>
    <div class="ecl-banner__info ecl-container">
      <div class="ecl-banner__container" data-ecl-banner-container>
        <div class="ecl-banner__content">
          <div class="ecl-banner__title">
            <span class="ecl-banner__title-text">
              EU Budget for the future
            </span>
          </div>
          <p class="ecl-banner__description">
            <span class="ecl-banner__description-text">
              Innovation, economy, environment and geopolitics
            </span>
          </p>
          <div class="ecl-banner__cta">
            <ecl-link style-class="ecl-banner__link-cta sc-ecl-banner-ec">
              <!---->
              <a class="ecl-banner__link-cta ecl-link ecl-link--cta ecl-link--icon ecl-link--icon-after sc-ecl-banner-ec" href="/example.html">
                <span class="ecl-link__label">
                  Subscribe
                </span>
                <slot-fb hidden="" name="icon-after"></slot-fb>
                <ecl-icon class="ecl-link__icon" slot="icon-after">
                  <span class="ecl-icon wt-icon--corner-arrow wt-icon--placeholder wt-icon--rotate-90 wt-icon--xs"></span>
                </ecl-icon>
              </a>
            </ecl-link>
          </div>
        </div>
      </div>
    </div>
  </section>
</ecl-banner>
`;

